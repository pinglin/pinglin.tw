<div id="scroll-top" class="fixed opacity-0 invisible bottom-4">
  <button
    onclick="window.scrollTo({top: 0, behavior: 'smooth'})"
    class="p-2 rounded-lg text-gray-900 bg-gray-50/90 dark:text-gray-100 dark:bg-gray-800/90 hover:bg-gray-100/90 dark:hover:bg-gray-700/90"
    aria-label="Scroll to top"
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
  </button>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const scrollButton = document.getElementById('scroll-top');
    const tocWrapper = document.getElementById('toc-wrapper');
    const topHeader = document.querySelector('header');

    function updatePositions() {
      if (scrollButton && tocWrapper && topHeader) {
        const headerRect = topHeader.getBoundingClientRect();
        // clientWidth, NOT innerWidth: innerWidth spans the scrollbar gutter that
        // the header does not, so on any page long enough to scroll (with classic
        // rather than overlay scrollbars) innerWidth overstates the offset by the
        // scrollbar width and both buttons drift left of the nav's right edge.
        const viewportRight = document.documentElement.clientWidth;
        const rightOffset = Math.max(0, viewportRight - headerRect.right);

        // Update TOC and scroll button positions with the same offset
        scrollButton.style.transition = 'all 0.8s ease';
        scrollButton.style.right = `${rightOffset}px`;
        tocWrapper.style.right = `${rightOffset}px`;
      }
    }

    function toggleScrollButton() {
      if (scrollButton && tocWrapper) {
        if (tocWrapper.classList.contains('visible')) {
          scrollButton.classList.remove('invisible');
          scrollButton.classList.add('visible');
          scrollButton.style.opacity = '1';
        } else {
          scrollButton.style.opacity = '0';
          setTimeout(() => {
            scrollButton.classList.remove('visible');
            scrollButton.classList.add('invisible');
          }, 300);
        }
      }
    }

    const observer = new MutationObserver(() => {
      toggleScrollButton();
    });

    if (tocWrapper) {
      observer.observe(tocWrapper, { attributes: true });
    }

    // Anything that changes the header's box has to re-run this: a resize, the
    // scrollbar appearing once late content makes the page scrollable, a webfont
    // swapping in, or a client-side navigation to a page of a different length.
    window.addEventListener('resize', updatePositions);
    window.addEventListener('load', updatePositions);
    document.addEventListener('astro:after-swap', updatePositions);
    document.addEventListener('astro:page-load', updatePositions);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(updatePositions);
    if (topHeader && 'ResizeObserver' in window) {
      new ResizeObserver(updatePositions).observe(topHeader);
    }
    // The scrollbar can appear after images and figures finish loading, which
    // moves the header's right edge without resizing the window.
    if ('ResizeObserver' in window) {
      new ResizeObserver(updatePositions).observe(document.documentElement);
    }
    // Initial position
    updatePositions();
  });
</script>
