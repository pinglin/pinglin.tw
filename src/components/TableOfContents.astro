<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tocWrapper = document.createElement('div');
    tocWrapper.id = 'toc-wrapper';
    tocWrapper.className = 'toc-wrapper';

    const tocHeader = document.createElement('div');
    tocHeader.className = 'toc-header';
    tocWrapper.appendChild(tocHeader);

    const tocButton = document.createElement('button');
    tocButton.className = 'toc-button';
    tocButton.innerHTML = `
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 6.00067L21 6.00139M8 12.0007L21 12.0015M8 18.0007L21 18.0015M3.5 6H3.51M3.5 12H3.51M3.5 18H3.51M4 6C4 6.27614 3.77614 6.5 3.5 6.5C3.22386 6.5 3 6.27614 3 6C3 5.72386 3.22386 5.5 3.5 5.5C3.77614 5.5 4 5.72386 4 6ZM4 12C4 12.2761 3.77614 12.5 3.5 12.5C3.22386 12.5 3 12.2761 3 12C3 11.7239 3.22386 11.5 3.5 11.5C3.77614 11.5 4 11.7239 4 12ZM4 18C4 18.2761 3.77614 18.5 3.5 18.5C3.22386 18.5 3 18.2761 3 18C3 17.7239 3.22386 17.5 3.5 17.5C3.77614 17.5 4 17.7239 4 18Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    `;
    tocButton.setAttribute('aria-label', 'Toggle Table of Contents');
    tocHeader.appendChild(tocButton);

    const tocList = document.createElement('ul');
    tocList.className = 'toc-list toc-hidden';
    tocWrapper.appendChild(tocList);

    const headers = document.querySelectorAll('h1, h2, h3, h4, h5, h6');
    const article = document.querySelector('[data-blog-article]');
    const articleUrl = article?.getAttribute('data-article-url');
    let topLevel = 6;

    function sectionPathFor(header, sectionId) {
      if (
        !articleUrl ||
        !header?.matches('h2, h3') ||
        !header.querySelector('[data-section-copy]')
      ) {
        return null;
      }

      const url = new URL(`sections/${encodeURIComponent(sectionId)}/`, articleUrl);
      return `${url.pathname}${url.search}`;
    }

    headers.forEach((header) => {
      const level = parseInt(header.tagName.charAt(1));
      topLevel = Math.min(topLevel, level);
    });

    headers.forEach((header) => {
      // Skip H1 headers
      if (header.tagName === 'H1') return;

      const listItem = document.createElement('li');
      const link = document.createElement('a');
      link.textContent = header.textContent;

      // The renderer already gives every heading a UNIQUE id (accuracy, accuracy-1,
      // accuracy-2 ...). Recomputing one from the text collapses repeated headings
      // onto a single anchor, so five "Accuracy" sections would all jump to the
      // first. Prefer the existing id; only synthesise one when it is missing, and
      // de-duplicate that against ids already in the document.
      let urlSafeId = header.id;
      if (!urlSafeId) {
        const base = encodeURIComponent(
          header.textContent
            .toLowerCase()
            .replace(/\s+/g, '-')
            .replace(/[^\w\u4E00-\u9FFF-]/g, ''),
        );
        let candidate = base;
        let n = 1;
        while (document.getElementById(candidate)) candidate = `${base}-${n++}`;
        urlSafeId = candidate;
        header.id = urlSafeId;
      }

      const sectionPath = sectionPathFor(header, urlSafeId);
      link.href = sectionPath || `#${urlSafeId}`;
      link.dataset.scrollTarget = urlSafeId;
      if (sectionPath) link.dataset.sectionPath = sectionPath;

      const actualLevel = parseInt(header.tagName.charAt(1));
      const adjustedLevel = actualLevel - topLevel + 1;
      listItem.classList.add(`toc-level-${adjustedLevel}`);

      listItem.appendChild(link);
      tocList.appendChild(listItem);
    });

    // A "Preface" entry for the prose above the first heading, so the reader can
    // jump back to the opening from anywhere in a long post. Only added when such
    // prose exists: a page whose content starts at a heading gets no entry, and
    // the id is de-duplicated in case a post already has one called "preface".
    const contentRoot = document.querySelector('.markdown-content');
    const firstContentHeading = contentRoot?.querySelector('h2, h3, h4, h5, h6');
    const hasPreface =
      contentRoot && firstContentHeading && contentRoot.firstElementChild !== firstContentHeading;

    if (hasPreface && tocList.children.length) {
      let prefaceId = 'preface';
      let n = 1;
      while (document.getElementById(prefaceId)) prefaceId = `preface-${n++}`;

      const prefaceAnchor = document.createElement('span');
      prefaceAnchor.id = prefaceId;
      contentRoot.insertBefore(prefaceAnchor, contentRoot.firstChild);

      const prefaceItem = document.createElement('li');
      prefaceItem.classList.add('toc-level-1');
      const prefaceLink = document.createElement('a');
      prefaceLink.textContent = 'Preface';
      prefaceLink.href = `#${prefaceId}`;
      prefaceItem.appendChild(prefaceLink);
      tocList.insertBefore(prefaceItem, tocList.firstChild);
    }

    document
      .querySelector('body')
      ?.insertBefore(tocWrapper, document.querySelector('body')?.firstChild);

    const tocWrapperElement = document.getElementById('toc-wrapper');
    if (tocWrapperElement) {
      tocButton.addEventListener('click', (event) => {
        event.stopPropagation();
        tocList.classList.toggle('toc-hidden');
        tocWrapperElement.classList.toggle('expanded');
      });

      // Add click outside listener
      document.addEventListener('click', (event) => {
        const isClickOnHeaderLink = event.target.closest('.toc-list a');
        if (!isClickOnHeaderLink && !tocList.classList.contains('toc-hidden')) {
          tocList.classList.add('toc-hidden');
          tocWrapperElement.classList.remove('expanded');
        }
      });

      const topHeader = document.querySelector('header');
      const firstHeader = document.querySelector('h1, h2, h3, h4, h5, h6');

      function updateTocPosition() {
        const headerRect = topHeader.getBoundingClientRect();
        const topOffset = headerRect.height + 20;
        // Align with the header's inner content area (matching its `px-4`
        // / 16 px padding), so the TOC button sits in line with the social
        // icons rather than flush against the viewport edge.
        const rightOffset = window.innerWidth - headerRect.right + 16;

        tocWrapperElement.style.transition = 'all 0.8s ease';
        tocWrapperElement.style.position = 'fixed';
        tocWrapperElement.style.left = 'auto';
        tocWrapperElement.style.top = `${topOffset}px`;
        tocWrapperElement.style.right = `${rightOffset}px`;

        // The panel is fixed, so a long post's list would otherwise extend past
        // the bottom of the window with its last entries unreachable. Cap it to
        // whatever is left below the toggle button and let it scroll inside.
        const buttonHeight = tocHeader.getBoundingClientRect().height;
        const available = window.innerHeight - topOffset - buttonHeight - 32;
        tocList.style.maxHeight = `${Math.max(160, available)}px`;
      }

      function updateTocVisibility() {
        const firstHeaderRect = firstHeader.getBoundingClientRect();
        const headerHeight = topHeader.getBoundingClientRect().height;

        if (firstHeaderRect.top < headerHeight) {
          tocWrapperElement?.classList.add('visible');
        } else {
          tocWrapperElement?.classList.remove('visible');
        }
      }

      function handleResize() {
        updateTocPosition();
        updateTocVisibility();
      }

      window.addEventListener('scroll', updateTocVisibility);
      window.addEventListener('resize', updateTocPosition);
      window.addEventListener('resize', handleResize);
      updateTocVisibility();
      updateTocPosition();

      document.querySelectorAll('a[href^="#"], a[data-scroll-target]').forEach((anchor) => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();

          const targetId = this.dataset.scrollTarget || this.getAttribute('href').substring(1);
          const targetElement = document.getElementById(targetId);

          if (targetElement) {
            const headerRect = topHeader.getBoundingClientRect();
            const yOffset = headerRect.top - 85;
            const y = targetElement.getBoundingClientRect().top + window.scrollY + yOffset;

            // H2/H3 headings are social-sharing entry points, so navigating to
            // one must leave a crawler-visible permalink in the address bar.
            // Figures, equations and other document anchors remain fragments.
            const nextUrl =
              this.dataset.sectionPath || sectionPathFor(targetElement, targetId) || `#${targetId}`;
            history.pushState(null, '', nextUrl);

            window.scrollTo({ top: y, behavior: 'smooth' });

            if (this.closest('.toc-list')) {
              tocList.classList.toggle('toc-hidden');
              tocWrapperElement.classList.toggle('expanded');
            }
          }
        });
      });
    }

    if (window.location.hash) {
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      const handleScroll = () => {
        const targetId = window.location.hash.substring(1);
        const targetElement = document.getElementById(targetId);
        const topHeader = document.querySelector('header');

        if (targetElement && topHeader) {
          requestAnimationFrame(() => {
            const headerRect = topHeader.getBoundingClientRect();
            const yOffset = headerRect.top - 85;
            const y = targetElement.getBoundingClientRect().top + window.scrollY + yOffset;
            window.scrollTo({ top: y, behavior: 'smooth' });
          });
        }
      };

      window.addEventListener('DOMContentLoaded', handleScroll);
      window.addEventListener('load', handleScroll);
    }
  });
</script>
