---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import MarkdownPostLayout from '../../../layouts/MarkdownPostLayout.astro';
import { getBlogSections, type BlogSection } from '../../../lib/blog-sections';

export const prerender = true;

// Generate a zh-tw path for every post: translated posts render their zh-tw
// entry; English-only posts redirect to the English page instead of 404ing.
export async function getStaticPaths() {
  // Same production draft gate as the English route, so a draft does not leak
  // a zh-tw redirect stub.
  const allEntries = await getCollection('blog', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const zhEntries = allEntries.filter(({ id }) => id.startsWith('zh-tw/'));
  const zhSlugs = new Set(zhEntries.map((entry) => entry.slug.split('/').slice(1).join('/')));
  const englishOnly = allEntries.filter(
    ({ id, slug }) => !id.startsWith('zh-tw/') && !zhSlugs.has(slug),
  );

  const translatedPaths = await Promise.all(
    zhEntries.map(async (entry: CollectionEntry<'blog'>) => {
      const slug = entry.slug.split('/').slice(1).join('/');
      const articlePath = `/zh-tw/blog/${slug}/`;
      const sections = await getBlogSections(entry);
      return [
        { params: { slug }, props: { entry, articlePath } },
        ...sections.map((section) => ({
          params: { slug: `${slug}/sections/${section.slug}` },
          props: { entry, articlePath, section },
        })),
      ];
    }),
  );

  return [
    ...translatedPaths.flat(),
    ...englishOnly.map((entry: CollectionEntry<'blog'>) => ({
      params: { slug: entry.slug },
      props: { redirectTo: `/blog/${entry.slug}` },
    })),
  ];
}

type Props =
  | {
      entry: CollectionEntry<'blog'>;
      articlePath: string;
      section?: BlogSection;
      redirectTo?: never;
    }
  | { entry?: never; redirectTo: string };
const { entry, articlePath, section, redirectTo } = Astro.props as {
  entry?: CollectionEntry<'blog'>;
  articlePath?: string;
  section?: BlogSection;
  redirectTo?: string;
};

if (redirectTo) {
  return Astro.redirect(redirectTo, 302);
}

const { Content } = await entry!.render();
---

<MarkdownPostLayout frontmatter={entry!.data} articlePath={articlePath!} {section}>
  <Content />
</MarkdownPostLayout>
