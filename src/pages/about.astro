---
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = 'About | pinglin.tw';
---

<BaseLayout pageTitle={pageTitle}>
  <div class="flex flex-col md:flex-row gap-6 items-stretch">
    <div class="flex flex-col gap-4">
      <p>Hello there!</p>
      <p>
        I'm Ping-Lin Chang (張秉霖), and friends call me Pinglin. I'm an entrepreneur working on AI
        and data. Currently, I am working with
        <a href="https://github.com/xiaofei-du" class="text-info hover:underline">Xiaofei Du</a> at
        <a href="https://a40.ai" class="text-info hover:underline">A40 Labs</a>, where we're
        building interesting stuff for our curiosity.
      </p>
      <p>
        I come from a computer vision and machine learning research background, with a PhD in
        robotic vision from Imperial College London followed by a post-doc at UCL. In 2014 I left
        UCL to co-found Umbo Computer Vision, where as CTO I built real-time deep-learning video
        security products running on cloud GPUs and edge AI hardware. In 2020, Xiaofei and I founded
        <a href="https://www.instill-ai.com" class="text-info hover:underline">Instill AI</a>,
        building open-source unstructured data ETL infrastructure —
        <a href="https://github.com/instill-ai/instill-core" class="text-info hover:underline">
          Instill Core
        </a> — on the belief that processing unstructured data should be as easy as processing structured
        data. Off the keyboard:
      </p>
      <ul class="list-disc list-inside space-y-1">
        <li>Proud father of one</li>
        <li>Music enthusiast with relative pitch</li>
      </ul>
      <p class="md:mt-auto pt-2">
        Check out my <a
          href="https://scholar.google.com/citations?user=mR95vtsAAAAJ&hl=en"
          class="text-info hover:underline"
        >
          Google Scholar
        </a> profile for more details.
      </p>
    </div>
    <div class="md:w-2/5 flex-shrink-0">
      <img src="/me.jpg" class="w-full h-auto rounded-md" />
    </div>
  </div>
</BaseLayout>
