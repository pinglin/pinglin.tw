# Dependency directories
node_modules/

# Astro build output
.astro

# Vercel build output
.vercel

# Build output
dist

# The global ~/.gitignore excludes .claude entirely; re-include the versioned
# skills so they travel with a clone. Each level must be re-included in turn —
# git cannot un-ignore a path whose parent directory is still excluded.
!.claude/
!.claude/skills/
!.claude/skills/**
