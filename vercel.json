{
  "framework": "astro",
  "trailingSlash": true,
  "devCommand": "pnpm run dev",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pinglin.tw" }],
      "destination": "https://pinglin.tw/:path*",
      "permanent": true
    }
  ]
}
